{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [{ "source": "/(.*)", "destination": "/api" }],
	"crons": [
		{
			"path": "/internal/sync/google",
			"schedule": "0 0 * * *"
		},
		{
			"path": "/internal/sync/rates",
			"schedule": "0 6 * * *"
		},
		{
			"path": "/internal/telemetry/rollup",
			"schedule": "0 7 * * *"
		}
	]
}
